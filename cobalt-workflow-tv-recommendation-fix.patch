--- a/.github/workflows/android_27.lts.yaml
+++ b/.github/workflows/android_27.lts.yaml
@@ -347,6 +347,198 @@ jobs:
           PY
           git diff -- "$DOC_FILE" || true
 
+      - name: Patch Cobalt TV Recommendation Channel
+        shell: bash
+        run: |
+          set -euo pipefail
+          cd src
+          MANIFEST=""
+          for candidate in \
+            "cobalt/shell/android/shell_apk/AndroidManifest.xml.jinja2" \
+            "cobalt/shell/android/shell_apk/AndroidManifest.xml"
+          do
+            if [ -f "$candidate" ]; then
+              MANIFEST="$candidate"
+              break
+            fi
+          done
+          if [ -n "$MANIFEST" ]; then
+            if ! grep -qF 'android.permission.WRITE_EPG_DATA' "$MANIFEST" || \
+               ! grep -qF 'android.permission.READ_EPG_DATA' "$MANIFEST"; then
+              python3 - "$MANIFEST" <<'PY'
+          import sys
+          from pathlib import Path
+
+          path = Path(sys.argv[1])
+          text = path.read_text(encoding="utf-8")
+          anchor = '    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>\n'
+          additions = []
+          for permission in ("WRITE_EPG_DATA", "READ_EPG_DATA"):
+              entry = f'    <uses-permission android:name="android.permission.{permission}"/>\n'
+              if entry not in text:
+                  additions.append(entry)
+          if additions:
+              if text.count(anchor) != 1:
+                  print(f"Manifest anchor not found in {path}; skipping permission patch.", file=sys.stderr)
+                  sys.exit(0)
+              path.write_text(text.replace(anchor, anchor + "".join(additions)), encoding="utf-8")
+          PY
+            fi
+          fi
+
+          TARGET_DIR="cobalt/shell/android/java/src/dev/cobalt/shell"
+          JAVA_FILE="$TARGET_DIR/TvRecommendationPublisher.java"
+          if [ -d "$TARGET_DIR" ] && [ ! -f "$JAVA_FILE" ]; then
+            cat > "$JAVA_FILE" <<'JAVA'
+          // Copyright 2026 The Cobalt Authors. All Rights Reserved.
+          //
+          // Licensed under the Apache License, Version 2.0 (the "License");
+          // you may not use this file except in compliance with the License.
+          // You may obtain a copy of the License at
+          //
+          //     http://www.apache.org/licenses/LICENSE-2.0
+          //
+          // Unless required by applicable law or agreed to in writing, software
+          // distributed under the License is distributed on an "AS IS" BASIS,
+          // WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+          // See the License for the specific language governing permissions and
+          // limitations under the License.
+
+          package dev.cobalt.shell;
+
+          import android.content.ContentResolver;
+          import android.content.ContentUris;
+          import android.content.ContentValues;
+          import android.content.Context;
+          import android.content.Intent;
+          import android.database.Cursor;
+          import android.media.tv.TvContract;
+          import android.net.Uri;
+          import android.util.Log;
+
+          /** Publishes a small preview channel so Android TV launchers can show a TizenTube card. */
+          public final class TvRecommendationPublisher {
+            private static final String TAG = "TvRecommendationPublisher";
+            private static final String CHANNEL_NAME = "TizenTube";
+
+            private TvRecommendationPublisher() {}
+
+            /** Called once the shell UI is attached; failures are logged and never break startup. */
+            public static void publish(Context context) {
+              try {
+                ContentResolver resolver = context.getContentResolver();
+                Uri channelUri = findOrCreateChannel(resolver, context);
+                if (channelUri == null) {
+                  Log.w(TAG, "Channel insertion was denied (WRITE_EPG_DATA unavailable?).");
+                  return;
+                }
+                long channelId = ContentUris.parseId(channelUri);
+
+                Intent intent =
+                    new Intent(Intent.ACTION_VIEW, Uri.parse("https://www.youtube.com/tv"))
+                        .setPackage(context.getPackageName())
+                        .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+
+                ContentValues program = new ContentValues();
+                program.put(TvContract.PreviewPrograms.COLUMN_CHANNEL_ID, channelId);
+                program.put(TvContract.PreviewPrograms.COLUMN_TITLE, CHANNEL_NAME);
+                program.put(
+                    TvContract.PreviewPrograms.COLUMN_SHORT_DESCRIPTION, "Open TizenTube in Cobalt");
+                program.put(
+                    TvContract.PreviewPrograms.COLUMN_INTENT_URI,
+                    intent.toUri(Intent.URI_INTENT_SCHEME));
+                program.put(TvContract.PreviewPrograms.COLUMN_WEIGHT, 1.0f);
+
+                resolver.delete(
+                    TvContract.PreviewPrograms.CONTENT_URI,
+                    TvContract.PreviewPrograms.COLUMN_CHANNEL_ID + "=?",
+                    new String[] {String.valueOf(channelId)});
+                resolver.insert(TvContract.PreviewPrograms.CONTENT_URI, program);
+              } catch (SecurityException | IllegalArgumentException e) {
+                Log.w(TAG, "Unable to publish TV recommendation: " + e.getMessage());
+              }
+            }
+
+            private static Uri findOrCreateChannel(ContentResolver resolver, Context context) {
+              String[] projection = {TvContract.Channels._ID};
+              String selection =
+                  TvContract.Channels.COLUMN_PACKAGE_NAME
+                      + "=? AND "
+                      + TvContract.Channels.COLUMN_DISPLAY_NAME
+                      + "=?";
+              Cursor cursor =
+                  resolver.query(
+                      TvContract.Channels.CONTENT_URI,
+                      projection,
+                      selection,
+                      new String[] {context.getPackageName(), CHANNEL_NAME},
+                      null);
+              if (cursor != null) {
+                try {
+                  if (cursor.moveToFirst()) {
+                    return TvContract.buildChannelUri(cursor.getLong(0));
+                  }
+                } finally {
+                  cursor.close();
+                }
+              }
+
+              ContentValues channel = new ContentValues();
+              channel.put(TvContract.Channels.COLUMN_DISPLAY_NAME, CHANNEL_NAME);
+              channel.put(TvContract.Channels.COLUMN_PACKAGE_NAME, context.getPackageName());
+              channel.put(TvContract.Channels.COLUMN_TYPE, TvContract.Channels.TYPE_PREVIEW);
+              return resolver.insert(TvContract.Channels.CONTENT_URI, channel);
+            }
+          }
+          JAVA
+          fi
+
+          BUILD_FILE="cobalt/shell/android/BUILD.gn"
+          if [ -f "$JAVA_FILE" ] && [ -f "$BUILD_FILE" ] && \
+             ! grep -qF 'TvRecommendationPublisher.java' "$BUILD_FILE"; then
+            python3 - "$BUILD_FILE" <<'PY'
+          import sys
+          from pathlib import Path
+
+          path = Path(sys.argv[1])
+          text = path.read_text(encoding="utf-8")
+          anchor = '    "java/src/dev/cobalt/shell/StartupGuardNavigationObserver.java",\n  ]\n'
+          entry = '    "java/src/dev/cobalt/shell/TvRecommendationPublisher.java",\n'
+          if entry in text:
+              sys.exit(0)
+          if text.count(anchor) != 1:
+              print(f"BUILD.gn anchor not found in {path}; skipping source list patch.", file=sys.stderr)
+              sys.exit(0)
+          replacement = anchor.replace("  ]\n", entry + "  ]\n")
+          path.write_text(text.replace(anchor, replacement), encoding="utf-8")
+          PY
+          fi
+
+          SHELL_FILE="cobalt/shell/android/java/src/dev/cobalt/shell/Shell.java"
+          if [ -f "$SHELL_FILE" ] && ! grep -qF 'TvRecommendationPublisher.publish' "$SHELL_FILE"; then
+            python3 - "$SHELL_FILE" <<'PY'
+          import sys
+          from pathlib import Path
+
+          path = Path(sys.argv[1])
+          text = path.read_text(encoding="utf-8")
+          anchor = "    mRootView = activity.findViewById(android.R.id.content);\n"
+          snippet = (
+              "\n"
+              "    Context appContext = context.getApplicationContext();\n"
+              "    if (appContext != null) {\n"
+              "      TvRecommendationPublisher.publish(appContext);\n"
+              "    }\n"
+          )
+          if text.count(anchor) != 1:
+              print(f"Shell.java anchor not found in {path}; skipping hook patch.", file=sys.stderr)
+              sys.exit(0)
+          path.write_text(text.replace(anchor, anchor + snippet), encoding="utf-8")
+          PY
+          fi
+
+          git diff --stat || true
+
       - name: Generate Android Debug Keystore
         run: |
           OUT_DIR="out/${{ inputs.platform }}_${{ inputs.build_type }}"
