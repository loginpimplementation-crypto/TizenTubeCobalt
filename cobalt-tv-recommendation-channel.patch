+
+package dev.cobalt.shell;
+
+import android.content.ContentResolver;
+import android.content.ContentUris;
+import android.content.ContentValues;
+import android.content.Context;
+import android.content.Intent;
+import android.database.Cursor;
+import android.media.tv.TvContract;
+import android.net.Uri;
+import android.util.Log;
+
+/** Publishes a small preview channel so Android TV launchers can show a TizenTube card. */
+public final class TvRecommendationPublisher {
+  private static final String TAG = "TvRecommendationPublisher";
+  private static final String CHANNEL_NAME = "TizenTube";
+
+  private TvRecommendationPublisher() {}
+
+  /** Called once the shell UI is attached; failures are logged and never break startup. */
+  public static void publish(Context context) {
+    try {
+      ContentResolver resolver = context.getContentResolver();
+      Uri channelUri = findOrCreateChannel(resolver, context);
+      if (channelUri == null) {
+        Log.w(TAG, "Channel insertion was denied (WRITE_EPG_DATA unavailable?).");
+        return;
+      }
+      long channelId = ContentUris.parseId(channelUri);
+
+      Intent intent =
+          new Intent(Intent.ACTION_VIEW, Uri.parse("https://www.youtube.com/tv"))
+              .setPackage(context.getPackageName())
+              .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+
+      ContentValues program = new ContentValues();
+      program.put(TvContract.PreviewPrograms.COLUMN_CHANNEL_ID, channelId);
+      program.put(TvContract.PreviewPrograms.COLUMN_TITLE, CHANNEL_NAME);
+      program.put(
+          TvContract.PreviewPrograms.COLUMN_SHORT_DESCRIPTION, "Open TizenTube in Cobalt");
+      program.put(
+          TvContract.PreviewPrograms.COLUMN_INTENT_URI,
+          intent.toUri(Intent.URI_INTENT_SCHEME));
+      program.put(TvContract.PreviewPrograms.COLUMN_WEIGHT, 1.0f);
+
+      resolver.delete(
+          TvContract.PreviewPrograms.CONTENT_URI,
+          TvContract.PreviewPrograms.COLUMN_CHANNEL_ID + "=?",
+          new String[] {String.valueOf(channelId)});
+      resolver.insert(TvContract.PreviewPrograms.CONTENT_URI, program);
+    } catch (SecurityException | IllegalArgumentException e) {
+      Log.w(TAG, "Unable to publish TV recommendation: " + e.getMessage());
+    }
+  }
+
+  private static Uri findOrCreateChannel(ContentResolver resolver, Context context) {
+    String[] projection = {TvContract.Channels._ID};
+    String selection =
+        TvContract.Channels.COLUMN_PACKAGE_NAME
+            + "=? AND "
+            + TvContract.Channels.COLUMN_DISPLAY_NAME
+            + "=?";
+    Cursor cursor =
+        resolver.query(
+            TvContract.Channels.CONTENT_URI,
+            projection,
+            selection,
+            new String[] {context.getPackageName(), CHANNEL_NAME},
+            null);
+    if (cursor != null) {
+      try {
+        if (cursor.moveToFirst()) {
+          return TvContract.buildChannelUri(cursor.getLong(0));
+        }
+      } finally {
+        cursor.close();
+      }
+    }
+
+    ContentValues channel = new ContentValues();
+    channel.put(TvContract.Channels.COLUMN_DISPLAY_NAME, CHANNEL_NAME);
+    channel.put(TvContract.Channels.COLUMN_PACKAGE_NAME, context.getPackageName());
+    channel.put(TvContract.Channels.COLUMN_TYPE, TvContract.Channels.TYPE_PREVIEW);
+    return resolver.insert(TvContract.Channels.CONTENT_URI, channel);
+  }
+}
